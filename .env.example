# HeyAgent environment variables (optional — prefer `hey models auth` and `hey connect`)

# Model providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# AWS Bedrock (API key from Bedrock console) — or: hey models auth bedrock
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1
# ElevenLabs — global voice (hey voice key / onboard / /voice → 2)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Integrations
# NOTION_API_TOKEN=
# GITHUB_TOKEN=

# Telegram (or use: hey telegram setup)
# TELEGRAM_BOT_TOKEN=

# Gateway
# HEYAGENT_HOME=~/.heyagent
